# ==============================================================================
# Google Ads MCP Server - Environment Configuration Template (.env)
# Copy this file to '.env' and fill in your actual credentials.
# Keep the '.env' file private and NEVER commit it to source control.
# ==============================================================================

# 1. Google Cloud Project ID
# Get this from: https://console.cloud.google.com/
# Set this to your Google Cloud project ID
GOOGLE_PROJECT_ID=your-gcp-project-id

# 2. Google Ads API Developer Token
# Get this from: Google Ads UI -> Tools & Settings -> Setup -> API Center
# Note: For production querying, requires "Explorer" or "Standard" access level.
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token

# 3. Google OAuth 2.0 Web Application Credentials
# Create these under: GCP Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
# Select application type: Web application
# Add Authorized Redirect URI: https://<your-railway-domain>/auth/callback
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# 4. Base URL of the deployed server
# For local testing, use: http://localhost:8000
# For Railway production, use: https://<your-railway-domain>
# (Do NOT include a trailing slash)
GOOGLE_ADS_MCP_BASE_URL=https://your-railway-domain.up.railway.app

# 5. Login Customer ID (Optional)
# Required ONLY if you authenticate through a Manager (MCC) account.
# Input the Manager Account Customer ID (numbers only, e.g., 1234567890).
# Leave empty if you are authenticating directly to a client account.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
